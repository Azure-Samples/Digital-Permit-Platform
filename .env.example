# Application
NEXT_PUBLIC_APP_NAME="Contoso Council Digital Permit Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=licensing@contoso.gov.uk
NEXT_PUBLIC_SUPPORT_PHONE="0345 678 9000"
# Set to `true` ONLY for local development or a public demo. The banner is
# shown to visitors so the sample banner should never ship with production.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SHOW_SAMPLE_BANNER=false
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NODE_ENV=development

# Database
DATABASE_URL="postgresql://licensing:licensing_dev_pw@localhost:5432/digital_permits?schema=public"

# Authentication
NEXTAUTH_URL=http://localhost:3000
# REQUIRED in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Enables the email/password provider used for the local demo only. Must be
# `false` in production, where sign-in flows through Microsoft Entra.
AUTH_ENABLE_DEMO_CREDENTIALS=false
DEMO_PASSWORD=

# Microsoft Entra External ID for applicants (optional locally)
ENTRA_EXTERNAL_ID_TENANT_ID=
ENTRA_EXTERNAL_ID_TENANT_SUBDOMAIN=
ENTRA_EXTERNAL_ID_CLIENT_ID=
ENTRA_EXTERNAL_ID_CLIENT_SECRET=

# Microsoft Entra ID workforce tenant for staff (optional locally)
ENTRA_WORKFORCE_TENANT_ID=
ENTRA_WORKFORCE_CLIENT_ID=
ENTRA_WORKFORCE_CLIENT_SECRET=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CONTAINER_EXPORTS=exports

# Azure OpenAI (optional; uses DefaultAzureCredential when configured)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Application Insights (optional locally; supplied by Azure infrastructure)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/gif,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Contoso Licensing <licensing@contoso.gov.uk>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
