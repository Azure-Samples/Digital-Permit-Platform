{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/*.css",
      "!.next",
      "!coverage",
      "!dist",
      "!node_modules",
      "!prisma/migrations",
      "!public/templates"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/pitch/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          },
          "complexity": {
            "noUselessEscapeInRegex": "off"
          },
          "correctness": {
            "noUnusedImports": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "suspicious": {
            "noGlobalIsFinite": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}