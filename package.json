{
  "name": "digital-permit-solution-accelerator",
  "version": "0.1.0",
  "description": "Configuration-driven digital licensing and permit solution accelerator for Microsoft Azure",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "validate:release": "node scripts/validate-public-release.mjs",
    "setup:identity": "node ./scripts/identity/bootstrap.mjs",
    "setup:deploy": "tsx ./scripts/setup/deploy.ts",
    "setup:installer:package": "node ./scripts/setup/build-installer-source.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:policy": "tsx --env-file-if-exists=.env prisma/seed-policy.ts",
    "db:seed:taxi-policy": "tsx --env-file-if-exists=.env prisma/seed-taxi-policy.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo-applications.ts",
    "db:seed:permits": "tsx --env-file-if-exists=.env prisma/seed-permits.ts",
    "db:seed:all": "npm run db:seed && npm run db:seed:policy && npm run db:seed:taxi-policy && npm run db:seed:permits && npm run db:seed:demo",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "templates:generate": "node scripts/generate-licence-template.mjs",
    "worker": "tsx src/lib/queue/worker-entry.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.17.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx-templates": "^4.15.0",
    "driver.js": "^1.3.6",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.22",
    "next-auth": "^4.24.7",
    "openai": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "prisma": "^6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "docx": "^9.7.1",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "esbuild": "0.28.1"
  }
}
